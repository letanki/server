# Server settings
PORT=1337
RESOURCE_PORT=9999

# Database settings (MongoDB)
# Coloque aqui a sua string de conexão do MongoDB
MONGODB_URI=mongodb://localhost:27017/letanki

# Logging
ENABLE_CONSOLE_LOGGING=true
LOG_LEVEL=info

# URL pública do painel web embutido no cliente (matchmaking competitivo).
# Deve apontar para a RESOURCE_PORT, rota /panel.
WEBPANEL_URL=http://localhost:9999/panel