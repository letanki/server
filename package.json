{
  "name": "letankiserver",
  "version": "1.0.0",
  "description": "TypeScript-based server for LeTanki game",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && npm run build:gen && tsc && cpx \"src/config/initial-config.json\" dist && cpx \"src/generated/**/*.json\" dist/generated",
    "build:gen": "npm run build:resources && npm run build:maps",
    "build:resources": "ts-node scripts/buildResources.ts",
    "build:maps": "ts-node scripts/buildMapData.ts && ts-node scripts/buildMapCollision.ts",
    "start": "node start.js",
    "dev": "ts-node -r tsconfig-paths/register scripts/dev.ts",
    "dev:prof": "TS_NODE_TRANSPILE_ONLY=1 node --prof -r ts-node/register -r tsconfig-paths/register src/server.ts",
    "parse:logs": "ts-node -r tsconfig-paths/register scripts/log-parser.ts",
    "extract:skyboxes": "ts-node scripts/extractSkyboxes.ts",
    "test": "node -r ts-node/register -r tsconfig-paths/register --test \"test/**/*.test.ts\"",
    "stress": "ts-node scripts/stress-test.ts",
    "targets": "ts-node scripts/target-bots.ts",
    "tara": "ts-node scripts/tara.ts",
    "set-role": "ts-node -r tsconfig-paths/register scripts/setRole.ts",
    "patch:list": "node scripts/patch-client.js --list",
    "patch:client": "node scripts/patch-client.js --all --deploy",
    "patch:deploy": "node scripts/patch-client.js --deploy-only"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/rimraf": "^3.0.2",
    "@types/xml2js": "^0.4.14",
    "cpx": "^1.5.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/letanki/server.git"
  },
  "author": "Danilo Palmeira",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "canvas": "^3.1.0",
    "cors": "^2.8.5",
    "crc-32": "^1.2.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fs-extra": "^11.2.0",
    "mkdirp": "^3.0.1",
    "mongoose": "^8.4.1",
    "protanki-protocol": "github:DaniloPalmeira/protanki-protocol",
    "rimraf": "^5.0.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
